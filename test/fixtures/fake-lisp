#!/bin/sh
# Deterministic fake lisp runtime. Modes via FAKE_LISP_MODE: ok | fail | sleep.
exec node -e '
const fs = require("node:fs");
const mode = process.env.FAKE_LISP_MODE || "ok";
const capture = process.env.FAKE_LISP_CAPTURE || "/tmp/fake-lisp-capture.json";
fs.writeFileSync(capture, JSON.stringify({ argv: process.argv.slice(1) }));
if (mode === "fail") { process.exit(2); }
if (mode === "sleep") { setTimeout(() => process.exit(0), 5000); }
else {
  process.stdout.write(";; fake lisp output\n(:ok \"canned\")\n");
  process.exit(0);
}
' -- "$@"
